{
  "id": "wf_viral_create_reels_scripts",
  "title": "릴스 스크립트 10개 뱃치",
  "description": "훅 라이브러리와 브랜드 맥락에서 앵글 10개를 골라 훅(3초)·본문·CTA·촬영 지시문이 완비된 릴스 스크립트 10편을 생산한다.",
  "outputDir": "content/drafts",
  "tags": ["content"],
  "inputs": [
    { "id": "brand_name", "kind": "scalar", "valueType": "text", "label": "브랜드명", "observed": "", "confidence": "low" },
    { "id": "niche", "kind": "scalar", "valueType": "text", "label": "니치/업종", "observed": "", "confidence": "low" },
    { "id": "target_audience", "kind": "scalar", "valueType": "text", "label": "타겟 오디언스 한 줄 설명", "observed": "", "confidence": "low" },
    { "id": "hook_library_path", "kind": "scalar", "valueType": "path", "label": "훅 라이브러리 CSV 경로 (없으면 비워두기)", "observed": "", "confidence": "low" }
  ],
  "nodes": [
    {
      "id": "n1",
      "type": "action",
      "title": "앵글 10개 선정",
      "detail": "hook_library_path에 파일이 있으면 읽어 미사용 훅 중 타겟에 맞는 것을 고르고, 없으면 니치·타겟 기반으로 훅을 직접 설계한다. 서로 다른 트리거 유형이 섞이도록 앵글 10개(훅+주제+포맷 유형)를 확정한다. 같은 유형이 3개를 넘지 않게 한다.",
      "acceptance": "트리거 유형이 4종 이상 섞인 앵글 10개가 확정됨.",
      "tool": "read",
      "toolSkills": [],
      "subtasks": [
        { "id": "s1", "title": "훅 라이브러리 로드·필터", "purpose": "미사용·타겟 적합 훅 후보 추리기" },
        { "id": "s2", "title": "앵글 10개 확정", "purpose": "훅×주제×포맷 조합, 유형 다양성 보장" }
      ],
      "inputScope": [
        { "name": "hook_library_path", "type": "path", "description": "선택 입력 — 훅 100개 CSV" },
        { "name": "brand_name", "type": "text" },
        { "name": "niche", "type": "text" },
        { "name": "target_audience", "type": "text" }
      ],
      "outputScope": [
        { "name": "selected_angles", "type": "json[]", "description": "10개: hook·topic·format·trigger_type" }
      ]
    },
    {
      "id": "n2",
      "type": "action",
      "title": "스크립트 10편 작성·저장",
      "detail": "앵글마다 릴스 스크립트를 작성해 md 한 파일로 저장한다. 각 편 구성: (1) 훅 — 0~3초 대사와 화면 자막, (2) 본문 — 15~30초 분량 대사를 장면 단위로, (3) CTA — 저장/공유/팔로우 유도 문장, (4) 촬영 지시문 — 장면별 구도·소품·자막 위치를 텍스트로(이미지 없이), (5) 캡션 첫 줄 초안. 브랜드 말투를 일관되게 유지한다.",
      "acceptance": "10편 모두 훅·본문·CTA·촬영 지시문·캡션이 채워진 md 저장.",
      "tool": "write",
      "toolSkills": ["md"],
      "subtasks": [
        { "id": "s1", "title": "편별 스크립트 작성", "purpose": "장면 단위 대사와 자막까지 구체화" },
        { "id": "s2", "title": "촬영 지시문 작성", "purpose": "촬영자가 바로 찍을 수 있는 지시 수준" },
        { "id": "s3", "title": "톤 일관성 점검", "purpose": "10편의 브랜드 말투 통일" }
      ],
      "inputScope": [
        { "name": "selected_angles", "type": "json[]" },
        { "name": "brand_name", "type": "text" },
        { "name": "target_audience", "type": "text" }
      ],
      "outputScope": [
        { "name": "scripts_written", "type": "number", "description": "작성된 스크립트 편수 (10이어야 함)" },
        { "name": "sections_written", "type": "text[]", "description": "각 편의 제목 목록" },
        { "name": "char_count", "type": "number", "description": "문서 전체 글자 수" }
      ]
    },
    {
      "id": "n3",
      "type": "validation",
      "title": "스크립트 완전성 검증",
      "detail": "scripts_written이 10인지, 각 편에 훅·본문·CTA·촬영 지시문 4요소가 모두 있는지, 훅 문장이 편끼리 중복되지 않는지, 본문이 30초 분량(공백 포함 350자 내외)을 크게 벗어나지 않는지 점검한다.",
      "acceptance": "is_valid=true이고 issues가 비어 있음.",
      "inputScope": [
        { "name": "scripts_written", "type": "number" },
        { "name": "sections_written", "type": "text[]" },
        { "name": "selected_angles", "type": "json[]" }
      ],
      "outputScope": [
        { "name": "is_valid", "type": "boolean" },
        { "name": "issues", "type": "string[]", "description": "문제 없으면 빈 배열" }
      ]
    }
  ]
}
