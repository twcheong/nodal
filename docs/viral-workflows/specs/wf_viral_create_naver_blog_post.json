      "acceptance": "2,000자 이상, 소제목 6개 이상, 이미지 지시문·태그·제목안 포함 md 저장.",
      "tool": "write",
      "toolSkills": ["md"],
      "subtasks": [
        { "id": "s1", "title": "섹션별 본문 집필", "purpose": "아웃라인의 메시지·분량 준수" },
        { "id": "s2", "title": "키워드·연관어 삽입", "purpose": "과최적화 없이 배치 계획 반영" },
        { "id": "s3", "title": "이미지 지시문·태그 수록", "purpose": "발행 준비 완성도 확보" }
      ],
      "inputScope": [
        { "name": "outline", "type": "json[]" },
        { "name": "title_options", "type": "text[]" },
        { "name": "brand_name", "type": "text" },
        { "name": "target_audience", "type": "text" }
      ],
      "outputScope": [
        { "name": "char_count", "type": "number", "description": "본문 글자 수 (2000 이상)" },
        { "name": "sections_written", "type": "text[]", "description": "작성된 소제목 목록" },
        { "name": "keyword_occurrences", "type": "number", "description": "본문 내 타겟 키워드 등장 횟수" },
        { "name": "image_slots", "type": "number", "description": "이미지 지시문 개수" }
      ]
    },
    {
      "id": "n4",
      "type": "validation",
      "title": "원고 품질 검증",
      "detail": "char_count가 2,000 이상인지, sections_written이 6개 이상인지, keyword_occurrences가 5~15 범위(과소/과최적화 방지)인지, 이미지 지시문이 3개 이상인지 점검한다.",
      "acceptance": "is_valid=true이고 issues가 비어 있음.",
      "inputScope": [
        { "name": "char_count", "type": "number" },
        { "name": "sections_written", "type": "text[]" },
        { "name": "keyword_occurrences", "type": "number" },
        { "name": "image_slots", "type": "number" }
      ],
      "outputScope": [
        { "name": "is_valid", "type": "boolean" },
        { "name": "issues", "type": "string[]", "description": "문제 없으면 빈 배열" }
