      "outputScope": [
        { "name": "title_options", "type": "text[]", "description": "제목 5안" },
        { "name": "outline", "type": "json[]", "description": "섹션별 소제목·핵심 메시지·목표 글자수" }
      ]
    },
    {
      "id": "n3",
      "type": "action",
      "title": "장문 원고 작성·저장",
