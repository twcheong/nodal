        { "id": "s3", "title": "콘텐츠 갭 발굴", "purpose": "아무도 안 다룬 차별화 포인트 찾기" }
      ],
      "inputScope": [
        { "name": "target_keyword", "type": "query", "description": "검색할 키워드" }
