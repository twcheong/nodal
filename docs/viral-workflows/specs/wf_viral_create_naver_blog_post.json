      "acceptance": "상위 글 5개 이상의 구조 분석과 콘텐츠 갭 2개 이상 도출.",
      "tool": "chrome",
      "toolSkills": ["seo-crawl"],
      "subtasks": [
        { "id": "s1", "title": "상위 글 수집·구조 기록", "purpose": "제목·글자수·소제목·키워드 배치 파악" },
