      "acceptance": "제목 5안과 소제목 6개 이상의 섹션 계획이 완성됨.",
      "tool": "read",
      "toolSkills": [],
      "subtasks": [
        { "id": "s1", "title": "제목 5안 작성", "purpose": "키워드 포함 + 클릭 유인 조합" },
        { "id": "s2", "title": "섹션 구조·분량 설계", "purpose": "공통 주제 + 갭 커버 아웃라인" },
        { "id": "s3", "title": "키워드 배치 계획", "purpose": "본문 내 자연스러운 등장 위치 결정" }
      ],
      "inputScope": [
        { "name": "serp_analysis", "type": "json[]" },
        { "name": "common_topics", "type": "text[]" },
        { "name": "content_gaps", "type": "text[]" },
        { "name": "target_keyword", "type": "query" }
