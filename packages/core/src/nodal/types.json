{
  "types_version": "1",

  "$comment": [
    "nodal 타입 시스템의 단일 소스 (docs/design.md §4.3).",
    "Python(nodal.types)과 TypeScript(apps/web/src/graph/typesystem.ts)가 이 파일 하나를 읽는다.",
    "규칙을 두 번 쓰지 않는다 — 알고리즘은 양쪽에 있지만 규칙과 카탈로그는 여기에만 있다.",
    "이 파일은 두 에이전트 사이의 계약이다. 변경 전 사용자 확인 (AGENTS.md 협업 규칙 7).",
    "산출물이 아니라 손으로 쓰는 원본이다. schemas/ 의 생성물과 혼동하지 말 것."
  ],

  "type_expression": {
    "$comment": [
      "카탈로그와 conformance 케이스에서 타입을 표기하는 문법.",
      "양쪽 로더가 이 문법을 파싱한다."
    ],
    "grammar": [
      "\"Any\"                                    — 와일드카드 (1급 타입, 해킹이 아니다)",
      "\"<이름>\"                                 — catalog 참조 (INT, Image, Model ...)",
      "{\"list\": <TypeExpr>}                      — 리스트",
      "{\"union\": [<TypeExpr>, ...]}              — 합집합",
      "{\"opaque\": \"<이름>\", \"capabilities\": []}  — 능력 태그를 붙인 불투명 핸들",
      "{\"tensor\": {\"dtypes\": [], \"shape\": []}}   — 즉석 텐서 서술"
    ],
    "shape_dimension": [
      "정수  — 고정 크기. 양쪽이 정수면 값이 같아야 한다",
      "문자열 — 심볼 라벨(B, H, W, C). 임의 크기로 취급한다",
      "null  — 임의 크기. 라벨과 동일하게 취급한다"
    ]
  },

  "widget_vocabulary": {
    "$comment": [
      "위젯 힌트 중 **닫힌 어휘**를 가진 것들 (docs/design.md §9.4).",
      "",
      "여기 있는 이유: `widget` 은 OpenAPI 에서 자유 딕셔너리라 generated.ts 가",
      "`Record<string, unknown>` 을 준다. 그래서 프론트가 \"randomise\" 라고 오타를",
      "내도 양쪽이 각자 컴파일되고 런타임에야 드러난다 — AGENTS.md 규칙 7 이",
      "말하는 '조용히 어긋나는' 아래 칸이다.",
      "",
      "타입 시스템 파일에 위젯 어휘를 싣는 것이 어색해 보이지만, 대안은 두 에이전트가",
      "함께 읽는 파일을 **하나 더** 만드는 것이다. 그쪽이 더 나쁘다 — 이 파일은 이미",
      "양쪽이 로드하고 있고, 스스로를 '두 에이전트 사이의 계약'이라고 선언한다.",
      "",
      "값이 열려 있는 힌트(min·max·step·options·placeholder)는 여기 없다. 닫힌",
      "어휘만 둔다 — 그것만이 오타로 깨질 수 있다."
    ],

    "seed": {
      "control": ["fixed", "increment", "randomize"],
      "doc": "실행 후 시드 값을 어떻게 할 것인가. 값을 바꾸는 쪽은 프론트다 (design.md §9.4)."
    }
  },

  "catalog": {
    "$comment": [
      "core 는 이 항목들의 '서술자'만 안다. 실제 런타임 값(PIL 이미지, torch 텐서)은 모른다.",
      "core 가 torch 를 import 하지 않는다는 규칙과 충돌하지 않는 이유다.",
      "확장이 카탈로그에 타입을 추가하는 메커니즘은 M6 에서 정한다."
    ],

    "primitives": {
      "INT": { "title": "정수", "python": "int", "ts": "number" },
      "FLOAT": { "title": "실수", "python": "float", "ts": "number" },
      "STRING": { "title": "문자열", "python": "str", "ts": "string" },
      "BOOL": { "title": "불리언", "python": "bool", "ts": "boolean" }
    },

    "tensors": {
      "Image": {
        "title": "이미지",
        "dtypes": ["float32"],
        "shape": ["B", "H", "W", "C"]
      },
      "Mask": {
        "title": "마스크",
        "dtypes": ["float32"],
        "shape": ["B", "H", "W"]
      },
      "Latent": {
        "title": "잠재 텐서",
        "dtypes": ["float16", "float32"],
        "shape": ["B", "C", "H", "W"]
      }
    },

    "opaque": {
      "Model": { "title": "확산 모델 핸들", "capabilities": [] },
      "CLIP": { "title": "텍스트 인코더 핸들", "capabilities": [] },
      "Conditioning": { "title": "인코딩된 조건 핸들", "capabilities": [] },
      "VAE": { "title": "VAE 핸들", "capabilities": [] },
      "Scheduler": { "title": "샘플링 스케줄러 핸들", "capabilities": [] }
    }
  },

  "rules": {
    "$comment": [
      "호환은 항상 방향이 있다: source(출력 소켓) → target(입력 소켓).",
      "design.md §4.3 표의 5개 규칙 + 표에 없던 4개를 명시한 것이다."
    ],

    "exact_match": {
      "enabled": true,
      "doc": "같은 타입끼리는 언제나 호환된다. Image → Image."
    },
    "numeric_promotion": {
      "enabled": true,
      "edges": [["INT", "FLOAT"]],
      "doc": "INT → FLOAT 자동 허용. 역방향은 불허 — 정밀도가 조용히 사라진다."
    },
    "list_promotion": {
      "enabled": true,
      "doc": "T → List[T] 자동. 배치 처리가 자연스러워진다. 역방향(List[T] → T)은 불허."
    },
    "list_covariance": {
      "enabled": true,
      "doc": "A → B 가 호환이면 List[A] → List[B] 도 호환 (공변)."
    },
    "union_widening": {
      "enabled": true,
      "doc": "A → Union[A, B] 허용. 출처가 대상 멤버 중 하나에 호환이면 된다."
    },
    "union_narrowing": {
      "enabled": false,
      "doc": "Union[A, B] → A 불허. 단, 모든 멤버가 대상에 호환이면 그건 좁힘이 아니라 전부 호환이므로 허용된다."
    },
    "any_bidirectional": {
      "enabled": true,
      "doc": "Any → T 와 T → Any 모두 허용. 와일드카드는 1급 타입이지 해킹이 아니다."
    },
    "opaque_capability_subset": {
      "enabled": true,
      "doc": "대상의 능력 태그 집합이 출처의 부분집합이면 호환. Model[sdxl, unet] → Model[unet] 허용, 그 역은 불허."
    },
    "tensor": {
      "dtype": "subset",
      "rank": "equal",
      "symbolic_dim_matches_any": true,
      "doc": "출처 dtype 집합이 대상의 부분집합이고 랭크가 같으면 호환. 라벨/null 차원은 어떤 크기와도 매칭되고, 양쪽이 정수인 차원만 값이 일치해야 한다."
    }
  },

  "conformance": [
    { "from": "Image", "to": "Image", "compatible": true, "rule": "exact_match" },
    { "from": "Image", "to": "Mask", "compatible": false, "rule": "tensor" },
    { "from": "INT", "to": "INT", "compatible": true, "rule": "exact_match" },
    { "from": "STRING", "to": "BOOL", "compatible": false, "rule": "exact_match" },

    { "from": "INT", "to": "FLOAT", "compatible": true, "rule": "numeric_promotion" },
    { "from": "FLOAT", "to": "INT", "compatible": false, "rule": "numeric_promotion" },
    { "from": "BOOL", "to": "INT", "compatible": false, "rule": "numeric_promotion" },
    { "from": "INT", "to": "STRING", "compatible": false, "rule": "numeric_promotion" },

    { "from": "Image", "to": { "list": "Image" }, "compatible": true, "rule": "list_promotion" },
    { "from": { "list": "Image" }, "to": "Image", "compatible": false, "rule": "list_promotion" },
    { "from": "INT", "to": { "list": "FLOAT" }, "compatible": true, "rule": "list_promotion" },
    {
      "from": { "list": "INT" },
      "to": { "list": "FLOAT" },
      "compatible": true,
      "rule": "list_covariance"
    },
    {
      "from": { "list": "FLOAT" },
      "to": { "list": "INT" },
      "compatible": false,
      "rule": "list_covariance"
    },
    {
      "from": { "list": "Image" },
      "to": { "list": { "list": "Image" } },
      "compatible": true,
      "rule": "list_promotion"
    },

    {
      "from": "Image",
      "to": { "union": ["Image", "Mask"] },
      "compatible": true,
      "rule": "union_widening"
    },
    {
      "from": "INT",
      "to": { "union": ["FLOAT", "STRING"] },
      "compatible": true,
      "rule": "union_widening"
    },
    {
      "from": { "union": ["Image", "Mask"] },
      "to": "Image",
      "compatible": false,
      "rule": "union_narrowing"
    },
    {
      "from": { "union": ["INT", "FLOAT"] },
      "to": "FLOAT",
      "compatible": true,
      "rule": "union_narrowing",
      "why": "좁힘이 아니다 — INT 도 FLOAT 도 각각 FLOAT 에 호환이므로 모든 멤버가 통과한다"
    },
    {
      "from": { "union": ["Image", "Mask"] },
      "to": { "union": ["Image", "Mask", "Latent"] },
      "compatible": true,
      "rule": "union_widening"
    },
    {
      "from": "INT",
      "to": { "union": ["STRING", "BOOL"] },
      "compatible": false,
      "rule": "union_widening",
      "why": "넓힘은 멤버 중 하나에 호환될 때만 성립한다 — 아무 union 에나 꽂히지 않는다"
    },

    { "from": "Any", "to": "Image", "compatible": true, "rule": "any_bidirectional" },
    { "from": "Image", "to": "Any", "compatible": true, "rule": "any_bidirectional" },
    { "from": "Any", "to": "Any", "compatible": true, "rule": "any_bidirectional" },
    {
      "from": "Any",
      "to": { "list": "Image" },
      "compatible": true,
      "rule": "any_bidirectional"
    },

    {
      "from": { "opaque": "Model", "capabilities": ["sdxl", "unet"] },
      "to": { "opaque": "Model", "capabilities": ["unet"] },
      "compatible": true,
      "rule": "opaque_capability_subset"
    },
    {
      "from": { "opaque": "Model", "capabilities": ["unet"] },
      "to": { "opaque": "Model", "capabilities": ["sdxl", "unet"] },
      "compatible": false,
      "rule": "opaque_capability_subset"
    },
    {
      "from": { "opaque": "Model", "capabilities": ["sdxl"] },
      "to": { "opaque": "VAE", "capabilities": [] },
      "compatible": false,
      "rule": "opaque_capability_subset",
      "why": "능력이 부분집합이어도 핸들 이름이 다르면 호환되지 않는다"
    },
    {
      "from": "Conditioning",
      "to": "Conditioning",
      "compatible": true,
      "rule": "exact_match"
    },
    {
      "from": "CLIP",
      "to": "Conditioning",
      "compatible": false,
      "rule": "opaque_capability_subset",
      "why": "CLIP 은 인코더이고 Conditioning 은 그 출력이다. 둘을 섞으면 KSampler 의 positive 에 텍스트 인코더가 꽂힌다"
    },
    {
      "from": { "opaque": "Model", "capabilities": [] },
      "to": { "opaque": "Model", "capabilities": [] },
      "compatible": true,
      "rule": "exact_match"
    },

    {
      "from": { "tensor": { "dtypes": ["float32"], "shape": ["B", "H", "W", "C"] } },
      "to": { "tensor": { "dtypes": ["uint8", "float32"], "shape": ["B", "H", "W", "C"] } },
      "compatible": true,
      "rule": "tensor",
      "why": "dtype 부분집합"
    },
    {
      "from": { "tensor": { "dtypes": ["uint8", "float32"], "shape": ["B", "H", "W", "C"] } },
      "to": { "tensor": { "dtypes": ["float32"], "shape": ["B", "H", "W", "C"] } },
      "compatible": false,
      "rule": "tensor",
      "why": "출처가 uint8 도 내보낼 수 있는데 대상은 못 받는다"
    },
    {
      "from": { "tensor": { "dtypes": ["float32"], "shape": ["B", "H", "W"] } },
      "to": { "tensor": { "dtypes": ["float32"], "shape": ["B", "H", "W", "C"] } },
      "compatible": false,
      "rule": "tensor",
      "why": "랭크가 다르다"
    },
    {
      "from": { "tensor": { "dtypes": ["float32"], "shape": ["B", "H", "W", 3] } },
      "to": { "tensor": { "dtypes": ["float32"], "shape": ["B", "H", "W", 4] } },
      "compatible": false,
      "rule": "tensor",
      "why": "양쪽이 정수인 차원은 값이 같아야 한다"
    },
    {
      "from": { "tensor": { "dtypes": ["float32"], "shape": ["B", "H", "W", 3] } },
      "to": { "tensor": { "dtypes": ["float32"], "shape": ["B", "H", "W", null] } },
      "compatible": true,
      "rule": "tensor",
      "why": "null 차원은 어떤 크기와도 매칭된다"
    },
    {
      "from": "Image",
      "to": { "tensor": { "dtypes": ["uint8", "float32"], "shape": [null, null, null, null] } },
      "compatible": true,
      "rule": "tensor",
      "why": "카탈로그 이름은 텐서 서술자로 풀린다"
    }
  ]
}
