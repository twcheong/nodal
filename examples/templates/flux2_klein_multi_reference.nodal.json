{
  "nodal_version": "1",
  "id": "018f2c00-0000-7000-8000-0000000e0009",

  "definitions": {
    "flux2_klein_multi_reference": {
      "doc": "네 장의 캐릭터 이미지를 픽셀 융합 없이 FLUX.2 Klein의 독립 레퍼런스 토큰으로 넣어 정체성·의상·화풍을 보존한 새 장면을 생성한다.",
      "params": {
        "reference_1": {
          "type": "Image",
          "doc": "주 얼굴과 정체성 레퍼런스. 파일 경로 또는 asset:<hash>."
        },
        "reference_2": {
          "type": "Image",
          "doc": "다른 각도의 얼굴·헤어 레퍼런스. 파일 경로 또는 asset:<hash>."
        },
        "reference_3": {
          "type": "Image",
          "doc": "전신 체형·의상 레퍼런스. 파일 경로 또는 asset:<hash>."
        },
        "reference_4": {
          "type": "Image",
          "doc": "전체 렌더링 화풍·재질 레퍼런스. 파일 경로 또는 asset:<hash>."
        },
        "prompt": {
          "type": "STRING",
          "doc": "image 1..4에서 무엇을 보존하고 어떤 포즈·장면을 만들지 명시한다."
        },
        "transformer": {
          "type": "STRING",
          "doc": "models/diffusion_models의 FLUX.2 Klein transformer 파일명."
        },
        "text_encoder": {
          "type": "STRING",
          "doc": "models/text_encoders의 Qwen3 4B encoder 파일명."
        },
        "vae": {
          "type": "STRING",
          "doc": "models/vae의 FLUX.2 VAE 파일명."
        },
        "config_repo": {
          "type": "STRING",
          "default": "black-forest-labs/FLUX.2-klein-4B",
          "doc": "config/tokenizer/scheduler 메타데이터 출처."
        },
        "width": {
          "type": "INT",
          "default": 608,
          "widget": { "min": 256, "max": 2048, "step": 16 }
        },
        "height": {
          "type": "INT",
          "default": 1120,
          "widget": { "min": 256, "max": 2048, "step": 16 }
        },
        "steps": {
          "type": "INT",
          "default": 4,
          "widget": { "min": 1, "max": 50, "step": 1 }
        },
        "seed": {
          "type": "INT",
          "default": 0,
          "widget": { "seed": true, "control": "randomize", "min": 0, "max": 9007199254740991, "step": 1 }
        }
      },
      "nodes": {
        "load": {
          "type": "diffusion.Flux2KleinLoader",
          "inputs": {
            "transformer": { "$param": "transformer" },
            "text_encoder": { "$param": "text_encoder" },
            "vae": { "$param": "vae" },
            "config_repo": { "$param": "config_repo" }
          }
        },
        "generate": {
          "type": "diffusion.Flux2KleinMultiReference",
          "inputs": {
            "model": { "$link": ["load", "model"] },
            "reference_1": { "$param": "reference_1" },
            "reference_2": { "$param": "reference_2" },
            "reference_3": { "$param": "reference_3" },
            "reference_4": { "$param": "reference_4" },
            "prompt": { "$param": "prompt" },
            "width": { "$param": "width" },
            "height": { "$param": "height" },
            "steps": { "$param": "steps" },
            "seed": { "$param": "seed" }
          }
        },
        "save": {
          "type": "image.Save",
          "inputs": {
            "image": { "$link": ["generate", "image"] },
            "embed_workflow": true
          }
        }
      },
      "returns": {
        "image": { "$link": ["save", "asset"] }
      }
    }
  },

  "nodes": {
    "reference_1": {
      "type": "image.Load",
      "inputs": { "path": "examples/sample.png" }
    },
    "reference_2": {
      "type": "image.Load",
      "inputs": { "path": "examples/sample.png" }
    },
    "reference_3": {
      "type": "image.Load",
      "inputs": { "path": "examples/sample.png" }
    },
    "reference_4": {
      "type": "image.Load",
      "inputs": { "path": "examples/sample.png" }
    },
    "call": {
      "type": "subgraph.flux2_klein_multi_reference",
      "inputs": {
        "reference_1": { "$link": ["reference_1", "image"] },
        "reference_2": { "$link": ["reference_2", "image"] },
        "reference_3": { "$link": ["reference_3", "image"] },
        "reference_4": { "$link": ["reference_4", "image"] },
        "prompt": "Use the exact same character and rendering style from all four reference images in a new pose.",
        "transformer": "FLUX.2-klein-4B-transformer",
        "text_encoder": "qwen_3_4b.safetensors",
        "vae": "FLUX.2-klein-4B-vae",
        "width": 608,
        "height": 1120,
        "steps": 4,
        "seed": 8272026
      }
    }
  },
  "outputs": ["call"],
  "ui": {
    "$comment": "References remain separate model conditions; no median, mean, or contact-sheet fusion."
  }
}
