{
  "name": "@nodal/web",
  "version": "0.0.0",
  "private": true,
  "license": "LicenseRef-UNDECIDED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../../schemas/openapi.json -o src/api/generated.ts",
    "gen:api:check": "openapi-typescript ../../schemas/openapi.json -o node_modules/.cache/nodal-openapi.ts && diff -q node_modules/.cache/nodal-openapi.ts src/api/generated.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  }
}
