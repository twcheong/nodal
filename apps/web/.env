# 개발 서버의 기본값은 **실서버**다.
#
# vite.config.ts 가 이미 /api 와 /ws 를 127.0.0.1:8188 로 프록시하고 있다 —
# 그 프록시는 live 모드에서만 의미가 있다. 기본이 목이면 `pnpm dev` 로 띄운
# 화면이 실서버에 붙은 것처럼 보이지만 실제로는 아무것도 실행하지 않는다.
# 조용히 틀린 것보다 기본이 맞는 편이 낫다.
#
# VITE_NODAL_API_URL 을 비워 두면 같은 오리진의 상대 경로를 쓴다 — 즉 위 프록시를
# 탄다. 다른 호스트의 서버에 붙일 때만 채운다.
VITE_NODAL_API_MODE=live
VITE_NODAL_API_URL=

# 백엔드 없이 프론트만 만질 때는 목으로 돌린다:
#   VITE_NODAL_API_MODE=mock pnpm --filter @nodal/web dev
