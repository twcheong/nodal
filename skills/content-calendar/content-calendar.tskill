@workspace twixy

SKILL "Content Calendar"
  version: 1.0
  summary: "기간·채널·목표를 받아 한 달치 콘텐츠 캘린더(주제+카피 초안+게시일)를 짜서 시트로 발행한다."
  description: "Builds a content/campaign calendar from a brief: given a period, the target channels, and a goal/theme, it lays out a posting schedule with a topic, a draft hook/caption, the channel, and a suggested post date for each slot. Composition only — no new tools: pure LLM planning grounded in SOUL.md brand voice and any collected data, written out with tool-write-xlsx (local) or tool-write-gsheet (shareable). The marketer supplies period, channels, cadence (posts/week), and goal; the skill returns the calendar as a sheet plus a short rationale, so nobody starts a month from a blank page. Trigger phrases: 콘텐츠 캘린더, 콘텐츠 일정, 게시 일정 짜줘, 한 달 콘텐츠 계획, 캠페인 플랜, content calendar, posting schedule, content plan."
  tags: [content, calendar, planning, schedule, sheets, llm]
  trigger: "콘텐츠 캘린더, 콘텐츠 일정, 게시 일정, 한 달 콘텐츠, 콘텐츠 계획, 캠페인 플랜, content calendar, posting schedule, content plan, editorial calendar"
  output: "content calendar as XLSX in $DRAFTS or Google Sheet URL + rationale; emits content_calendar_ready"

PLATFORMS {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  TWITTER
  LINKEDIN
}

GOAL "Lay out a period content calendar" {
  objective: "Turn a period + channels + goal into a concrete posting schedule (topic, draft hook, channel, date per slot) in the brand voice, published as a sheet the marketer can edit and follow."
  kpi: calendars_shipped
}

PHASE "Brief" {
  COLLECT "Resolve the brief and brand context" {
    // LLM-only planning — "collect" means gathering inputs + brand context, not fetching a platform.
    - Resolve the brief from the user's request (infer defaults, ask only for what's genuinely missing):
      period: date range to plan, e.g. 이번 달 / next 4 weeks. Default: next 4 weeks.
      channels: which platforms. Default: the channels the user usually posts to (from data), else instagram.
      cadence: posts per week per channel. Default: 3.
      goal: the theme/objective for the period (launch, engagement, sales, awareness).
      format: "sheet" (Google) or "xlsx" (local). Default: xlsx.

    - Read SOUL.md for brand voice and banned phrasing so draft hooks match the brand.
    LOAD "latest" FROM $INSIGHTS AS $brand_context
    - If no insight file exists, proceed with SOUL.md + the brief alone — do not block on missing data.
  }
}

PHASE "Plan" {
  STRATEGIZE "Draft the calendar slots" {
    SPAWN calendar_planner
      TASK "Build a content calendar for {period} across {channels} at {cadence} posts/week per channel, aimed at {goal}. For every slot produce: date (spread realistically across the period), channel, topic/angle (varied — do not repeat one idea), a short draft hook/caption in the brand voice, and a content format (reel / carousel / short / post). Balance angles across the period (mix education, social proof, promotion, behind-the-scenes). Honor SOUL.md voice and banned phrasings. Return { rows: [[header...],[date,channel,topic,hook,format]...] } with a header row first, and a 2-3 bullet rationale for the overall arc. Ground topics in the provided brand context where relevant."
      USING $brand_context
      OUTPUT $calendar
      AWAIT

    PLAN Strategy AS $calendar_plan
      FROM $calendar
      ABOUT "summarize the month's narrative arc and flag the 2-3 highest-priority posts"
  }
}

PHASE "Publish" {
  TRACK "Write the calendar sheet and report" {
    LET $stem = "content_calendar_{date}"

    // Two output paths — pick by format.
    - If format == "xlsx": call tool-write-xlsx with relPath = "$DRAFTS/{stem}.xlsx" and payload = { sheets: [{ name: "Calendar", rows: $calendar.rows }] }. Returns { ok, relPath, bytes }.
    - If format == "sheet": call tool-google-status; if !connected, tell the user to connect Google (Settings → Google Workspace) and stop. If connected, call tool-write-gsheet with payload = { title: "Content Calendar — {period}", sheets: [{ name: "Calendar", rows: $calendar.rows }] } and use the returned $url verbatim.

    - Report to the user: the relative file path (e.g. content/drafts/content_calendar_2026-07-06.xlsx) or the Sheet URL, plus the narrative-arc summary from $calendar_plan.

    EMIT "content_calendar_ready"
      WITH payload = { stem: $stem, format: $format }
      TO SKILL "Watchtower"
  }
}
