{
  "nodal_version": "1",
  "id": "01994b00-0000-7000-8000-000000000001",
  "definitions": {
    "h3_image_video": {
      "doc": "Animate a supplied first-frame image with the locally installed MiniMax H3 Pruned model. Source accepts a server-local image path or asset reference.",
      "params": {
        "source": { "type": "Image", "doc": "First-frame image path or asset:<hash>." },
        "prompt": { "type": "STRING", "doc": "Describe the subject motion, camera and sound." },
        "seed": { "type": "INT", "default": 7 },
        "steps": { "type": "INT", "default": 16, "widget": { "min": 2, "max": 100 } },
        "width": {
          "type": "INT",
          "default": 384,
          "widget": { "min": 256, "max": 1920, "step": 32 }
        },
        "height": {
          "type": "INT",
          "default": 576,
          "widget": { "min": 256, "max": 1920, "step": 32 }
        }
      },
      "nodes": {
        "generate": {
          "type": "diffusion.MiniMaxH3",
          "inputs": {
            "model_path": "",
            "first_frame": { "$param": "source" },
            "prompt": { "$param": "prompt" },
            "seed": { "$param": "seed" },
            "steps": { "$param": "steps" },
            "width": { "$param": "width" },
            "height": { "$param": "height" },
            "num_frames": 124,
            "memory_profile": "pruned_convrot_int8_offload"
          }
        }
      },
      "returns": { "video": { "$link": ["generate", "video"] } }
    }
  },
  "nodes": {},
  "outputs": []
}
